# Copiez ce fichier en .env et renseignez votre clé.
# NE COMMITEZ JAMAIS le fichier .env réel (il est dans .gitignore).

# Clé API Hugging Face → https://huggingface.co/settings/tokens
# (nommée HF_TOKEN comme dans l'extrait OpenAI de la fiche du modèle)
HF_TOKEN=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
# HF_API_KEY fonctionne aussi si vous préférez ce nom.

# Modèle servi (fiche : https://huggingface.co/dphn/Dolphin-Mistral-24B-Venice-Edition)
HF_MODEL=dphn/Dolphin-Mistral-24B-Venice-Edition

# Provider d'inférence via HF Inference Providers → suffixe ":featherless-ai"
HF_PROVIDER=featherless-ai

# Optionnel : délai max d'une requête (ms)
# HF_TIMEOUT_MS=55000

# Optionnel : réponses simulées sans réseau (développement/preview)
# DEMO_MODE=0

# Optionnel : port du serveur local (Render/Vercel le définissent eux-mêmes)
# PORT=3000
